# ── Vet Pricing · Checkout API (Asaas) ──────────────────────────────
# Copie para o painel do Coolify (Environment Variables). NUNCA comite a chave real.

# Chave de API do Asaas (Configurações > Integrações > API).
# Comece pela SANDBOX; troque pela produção só depois de testar.
ASAAS_API_KEY=

# Ambiente do Asaas:
#   Sandbox:   https://sandbox.asaas.com/api/v3
#   Produção:  https://api.asaas.com/v3
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3

# Origem(s) do front autorizada(s) a chamar a API (separe por vírgula).
ALLOWED_ORIGIN=https://vet-pricing.alumine.com.br

# Porta do serviço (o Coolify mapeia o domínio para ela).
PORT=3000

# Valores por forma de pagamento (em reais) e vencimento.
PRICE_PIX=350
PRICE_CARD=390
PRICE_BOLETO=390
DUE_DAYS=2
CHARGE_DESCRIPTION=Vet Pricing: aula ao vivo (14/09, 20h)

# ── Meta: Conversions API e webhook do Asaas ────────────────────────
# Eventos server-side (AddPaymentInfo e Purchase). Sem isso o rastreamento
# funciona só no navegador e o Purchase nunca é enviado.

# Id do pixel — o MESMO valor de PIXEL_ID em tracking.js (raiz do repo).
META_PIXEL_ID=

# Token da Conversions API: Gerenciador de Eventos > seu pixel > Configurações
# > Conversions API > Gerar token de acesso.
META_CAPI_TOKEN=

# Opcional, só durante a validação: Gerenciador de Eventos > Testar eventos.
# Eventos com esse código NÃO contam para a otimização — apague depois.
META_TEST_EVENT_CODE=

# Opcional. Default v23.0.
META_API_VERSION=v23.0

# Token do webhook do Asaas (Configurações > Integrações > Webhooks).
# Sem ele o endpoint /asaas-webhook recusa tudo com 401.
ASAAS_WEBHOOK_TOKEN=

# URL pública do checkout, usada como event_source_url nos eventos do webhook.
PUBLIC_CHECKOUT_URL=https://vet-pricing.alumine.com.br/checkout.html
